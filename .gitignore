# Whitelist: only the built page and the deploy workflow are published.
# build.js, site.config.js, _src and the raw client photographs stay local
# (the site-security gate flags them as S1 if they are served or public).
*
!.gitignore
!.github/
!.github/**
!index.html

# Full site (site-buildout, 2026-11-20): the generated output only. generate.js, build-*.js,
# content/, site.config.js, _src/, _source/, _work/, AUTOPILOT.json and every .md stay local.
!_site/
!_site/**
